# Cartevy CRM — configuração local

# Runtime da aplicação.
# Supavisor Transaction Pooler.
# TLS/CA é configurado pelo adapter pg.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER-HOST:6543/postgres?pgbouncer=true"

# O padrão é verify-full com a CA versionada do Supabase.
# disable só é aceito pelo runtime para localhost/loopback em testes locais/CI.
DATABASE_SSL_MODE="verify-full"

# Prisma CLI / migrations.
# Certificado localizado dentro da pasta prisma/.
DIRECT_URL="postgresql://USER:PASSWORD@POOLER-HOST:5432/postgres?sslmode=require&sslcert=./supabase-prod-ca-2021.crt"

# Segredo server-side criptograficamente aleatório; nunca expor ao client.
AUTH_PASSWORD_PEPPER=

# Segredo server-side separado para HMAC de username/IP; aleatório e nunca público.
AUTH_RATE_LIMIT_SECRET=
