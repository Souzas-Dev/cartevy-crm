{
  "name": "cartevy-crm-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:persistence": "tsx scripts/persistence.integration.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "auth:bootstrap": "node --conditions=react-server --import tsx scripts/bootstrap-auth-user.ts",
    "auth:cleanup": "node --conditions=react-server --import tsx scripts/auth-cleanup.ts",
    "test:auth:persistence": "node --conditions=react-server --import tsx scripts/auth.integration.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "0.45.1",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "^18.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.28",
    "prisma": "^7.10.0",
    "supabase": "^2.117.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  },
  "type": "module"
}
